{
 "coreName": "TIC-80",
 "systemId": "TIC80",
 "systemNames": {
  "TIC80": "TIC-80"
 },
 "author": "Vadim Grigoruk (nesbox) and the TIC-80 authors; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-tic80",
 "romFile": "cart",
 "deterministic": true,
 "memoryLayoutMiB": [
  256,
  4,
  8,
  16,
  512
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as the machine touches it. A TIC-80 has 96 KB of memory and a cart is at most about 1 MB; the rest is room for the script language's own memory.",
 "video": {
  "_comment": "TIC-80's picture: its 240x136 screen in a border, 256x144 in all, with square pixels. With the Picture setting at 'screen' it is the 240x136 screen alone; the core says which size every frame. 60 frames a second.",
  "width": 256,
  "height": 144,
  "virtualWidth": 256,
  "virtualHeight": 144,
  "vsyncNumerator": 60,
  "vsyncDenominator": 1,
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "TIC-80's four sound channels, mixed to stereo at 44100 samples a second: 735 a frame.",
  "rate": 44100,
  "samplesPerFrame": 2048,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "settings": [
  {
   "name": "initialTime",
   "display": "Starting Clock",
   "type": "int",
   "min": 0,
   "max": 2147483647,
   "default": 946684800,
   "description": "The date and time a cart reads with tstamp() when it starts, in seconds since 1970 (Unix time); it then runs with the machine, at 60 frames a second. The default is the first of January 2000. The script languages also start their random numbers from this clock. This is a setting, and not your computer's clock, so that a movie plays back the same on any day. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "picture",
   "display": "Picture",
   "type": "enum",
   "options": [
    "full",
    "screen"
   ],
   "default": "full",
   "description": "'full' shows TIC-80's whole picture, 256x144: the 240x136 screen and the border around it, which carts can draw on. 'screen' shows the screen alone. Mouse X and Mouse Y are a place on the picture shown. It changes nothing in the machine."
  },
  {
   "name": "mouseCursor",
   "display": "Mouse Cursor",
   "type": "enum",
   "options": [
    "show",
    "hide"
   ],
   "default": "show",
   "description": "'show' draws the mouse cursor on the picture when the cart uses the mouse, as TIC-80's own player does: the cart's own cursor, or TIC-80's arrow. 'hide' leaves it out. It changes nothing in the machine."
  }
 ],
 "firmware": [],
 "extensions": {
  ".tic": "TIC80",
  ".png": "TIC80"
 },
 "input": {
  "name": "TIC-80 Controls",
  "_comment": "Four gamepads (Up, Down, Left, Right, A, B, X, Y), the mouse's three buttons and the 94 keys of TIC-80's keyboard. Mouse X and Mouse Y are where the mouse is, a fraction of the picture shown (0 to 65535). A cart that asks for the mouse's movement instead (TIC-80's relative mode) reads Mouse Move X and Y, how far it moved in the frame. Scroll X and Y are the wheel's turn in the frame. A cart sees at most four keys at once.",
